# Public site origin used for canonical URLs, sitemap, and Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite file. Created on first boot. Tests use their own temporary files.
DATABASE_PATH=./data/narrator.sqlite

# Uploaded references and generated media. Files are named by id, never by the upload name.
ASSET_DIR=./data/assets

# Demo mode lets local signup show the verification link and, in non-production,
# simulates Stripe purchases through the same ledger as a real webhook.
# Leave NARRATOR_ALLOW_DEMO_BILLING unset in any public deployment.
NARRATOR_DEMO=1
# NARRATOR_ALLOW_DEMO_BILLING=1

# Seed account. Used only by `npm run seed`.
DEMO_USER_EMAIL=demo@narrator.local
DEMO_USER_PASSWORD=narrator-demo-pass

# Set to 1 only behind a proxy you control. Narrator still keys limits by account,
# and it does not trust X-Forwarded-For.
TRUST_PROXY=0

# Shared secret for POST /api/internal/tick. Required outside demo mode.
JOB_TICK_SECRET=

# Provider daily ceiling for the whole server, in US dollars. Stops a bad price
# from draining a live gateway balance.
PROVIDER_DAILY_BUDGET_USD=50

# mock (default when no provider secret is set), treg, or http.
NARRATOR_PROVIDER=mock

# Treg gateway. Leave blank to stay on the local sample generator.
TREG_BASE_URL=https://treg.to
TREG_TOKEN=
TREG_STILL_ENDPOINT=nano-banana-2
TREG_VIDEO_ENDPOINT=veo-3.1-lite

# Alternate provider: your own HTTP adapter. JSON in, base64 media out.
MEDIA_HTTP_URL=
MEDIA_HTTP_TOKEN=

# Optional model rewrite of the shot plan. Without these, the scripted planner runs and costs nothing.
PLANNER_URL=
PLANNER_TOKEN=
PLANNER_MODEL=

# Stripe. Without STRIPE_SECRET_KEY, checkout stays in demo mode when demo billing is allowed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_MAKER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK_200=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_1000=

# Optional email. Signup always writes data/outbox. Resend is used when the key is present.
RESEND_API_KEY=
EMAIL_FROM=Narrator <noreply@example.com>

# Optional publishing. Never called by quote, ledger, generation, or Stripe code.
# Maker and Studio only. Tool slugs come from your Composio project.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_DRIVE_TOOL=
COMPOSIO_DROPBOX_TOOL=
COMPOSIO_SOCIAL_TOOL=
