# Public site origin used for canonical URLs, sitemap, and Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite file when DATABASE_URL is unset. Tests use their own temporary files.
DATABASE_PATH=./data/narrator.sqlite

# Cursor Hosting injects DATABASE_URL for managed Postgres. Leave it unset locally.
# DATABASE_URL=

# Uploaded references and generated media. Files are named by id, never by the upload name.
ASSET_DIR=./data/assets

# Demo mode lets local signup show the verification link and, in non-production,
# simulates Stripe purchases through the same ledger as a real webhook.
# Leave NARRATOR_ALLOW_DEMO_BILLING unset in any public deployment.
NARRATOR_DEMO=1
# NARRATOR_ALLOW_DEMO_BILLING=1

# Seed account. Used only by `npm run seed`.
DEMO_USER_EMAIL=demo@narrator.local
DEMO_USER_PASSWORD=narrator-demo-pass

# Set to 1 only behind a proxy you control. Narrator still keys limits by account,
# and it does not trust X-Forwarded-For.
TRUST_PROXY=0

# Shared secret for POST /api/internal/tick. Required outside demo mode.
JOB_TICK_SECRET=

# Provider daily ceiling for the whole server, in US dollars. Stops a bad price
# from draining a live gateway balance.
PROVIDER_DAILY_BUDGET_USD=50

# local (default, ffmpeg stills and H.264 clips), mock, treg, fal, or http.
# http is accepted only when MEDIA_HTTP_URL is on the locked API host list.
NARRATOR_PROVIDER=

# Live stills and clips. The first configured key wins: Treg, then Fal, then xAI or OpenAI.
# Video calls that time out fall back to the local ffmpeg clip.
TREG_TOKEN=
FAL_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# XAI_MODEL=grok-4

# Optional HTTP adapter. The host must be on the API allowlist or the call is refused.
MEDIA_HTTP_URL=
MEDIA_HTTP_TOKEN=

# Google sign-in. Without these, the Google button returns to /login?google=setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe. A secret key and webhook secret are enough. Omit the price ids and checkout
# uses inline price_data. `npm run stripe:setup` can create the catalog and prints
# only the price ids, never the secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_MAKER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK_200=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_1000=

# Optional email. Signup always writes data/outbox. Resend is used when the key is present.
RESEND_API_KEY=
EMAIL_FROM=NR8R <noreply@example.com>

# Optional publishing. Never called by quote, ledger, generation, or Stripe code.
# Drive and Dropbox are available on every plan. YouTube, X, and TikTok need Maker or Studio.
# The host is locked to https://backend.composio.dev.
COMPOSIO_API_KEY=

# GitHub Pages can point sign-in and checkout at the live server.
# NEXT_PUBLIC_APP_ORIGIN=https://example.com
